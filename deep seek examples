Concept 4: Compile-Time vs Runtime (In-Depth)
Compile-Time (When you build/compile your code)
kotlin
// These errors are caught BEFORE your program runs

// 1. Type mismatches
val name: String = "Nova"
// name = 42  // ❌ COMPILE ERROR: Type mismatch (String vs Int)

// 2. Syntax errors
// val x =   // ❌ COMPILE ERROR: Incomplete expression

// 3. Null safety violations
var city: String = "New York"
// city = null  // ❌ COMPILE ERROR: Null can not be a value of String

// 4. Unresolved references
// println(nonExistentVariable)  // ❌ COMPILE ERROR: Unresolved reference

// 5. Wrong function calls
// fun greet(name: String) { }
// greet()  // ❌ COMPILE ERROR: No value passed for parameter 'name'
Runtime (When your program is actually running)
kotlin
// These errors happen DURING execution

// 1. Array index out of bounds
val numbers = listOf(1, 2, 3)
// numbers[5]  // ❌ RUNTIME ERROR: Index 5 out of bounds

// 2. Null pointer (even with safe code)
var text: String? = null
// text!!.length  // ❌ RUNTIME ERROR: NullPointerException

// 3. Division by zero
fun divide(a: Int, b: Int): Int = a / b
// divide(10, 0)  // ❌ RUNTIME ERROR: ArithmeticException

// 4. Type cast errors
val obj: Any = "Hello"
// val num: Int = obj as Int  // ❌ RUNTIME ERROR: ClassCastException
Real-World Example:
kotlin
fun processUserInput(input: String) {
    // COMPILE-TIME CHECK: Type is correct (String)
    // RUNTIME CHECK: Is the input valid?
    
    val number = input.toIntOrNull()  // Might be null at runtime
    if (number != null) {
        println("Valid number: $number")
    } else {
        println("Invalid input at runtime!")
    }
}

fun main() {
    processUserInput("123")   // ✅ Works
    processUserInput("abc")   // ⚠️ Runtime check catches it
}
