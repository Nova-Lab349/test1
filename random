fun main() {
    //can have muiltple in one val with arrayOf()
	val cool = arrayOf("idk", "ok", "okay")
    
    //count how many are in different val are in that one val
    println(cool.size)
    
    //this is to get one specific variables in the array so for example(0 get the first, 1 get the 2nd, ect)
    //[] & .get are the same thing
    println(cool[0])
    println(cool.get(1))
    
    
    
    
    for (cool in cool) {
        println(cool)
    }
	cool.forEach { cool ->
    	println(cool)
	}
}
